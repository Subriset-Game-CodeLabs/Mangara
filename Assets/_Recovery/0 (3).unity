  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0686b34921e55ca4691c58921f44e169, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BestiaryManager
  unlockedMangroves: 
  mangroveDatabase:
  - type: 0
    mangroveName: 'Rhizophora '
    description: Rhizophora adalah genus tumbuhan bakau (mangrove) yang termasuk
      dalam famili Rhizophoraceae, dikenal luas karena sistem akar tunjangnya (stilt
      roots atau akar tongkat) yang khas, tumbuh melengkung keluar dari batang sebelum
      menembus ke dalam substrat berlumpur. Struktur akar ini berfungsi untuk menstabilkan
      pohon di tanah yang lunak dan tergenang air pasang, sekaligus membantu proses
      respirasi melalui lentisel yang memungkinkan pertukaran gas saat akar terendam
      air. Genus ini mencakup beberapa spesies seperti Rhizophora apiculata, Rhizophora
      mucronata, dan Rhizophora stylosa, yang tersebar di kawasan pesisir tropis
      dan subtropis, termasuk pesisir Indonesia, sebagai bagian penting dari ekosistem
      hutan mangrove.
    mangroveImage: {fileID: 21300000, guid: 305b34b4e7e17fe4bb6a302c02d29cf0, type: 3}
